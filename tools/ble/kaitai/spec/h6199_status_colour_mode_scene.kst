# H6199 colour-mode status reply, captured from the Govee Home iOS app driving the
# DreamView T1 over BLE. Taken with the light showing a scene the app had applied moments earlier in the same session, which is what pins the id.
id: h6199_status_colour_mode_scene
data: h6199_status_colour_mode_scene.bin
imports:
  - h6199_status_reply
asserts:
  - actual: domain
    expected: 5
  - actual: body.mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 10005
