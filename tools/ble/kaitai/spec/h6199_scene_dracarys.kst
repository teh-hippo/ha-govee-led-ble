# H6199 scene-apply write, captured 2026-08-04 from the Govee Home iOS app driving the
# DreamView T1 over BLE. The light was off Govee's cloud, so the app reached it by no path
# but this one; the PHONE was online, which is what made the cloud-backed scene gallery
# usable at all. Applied from the House of the Dragon row, preceded by a 119-byte 0xA3 upload. This row is the only one captured whose numbers have a non-zero high byte.
id: h6199_scene_dracarys
data: h6199_scene_dracarys.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 16182
  - actual: body.detail.scene_class
    expected: 2
