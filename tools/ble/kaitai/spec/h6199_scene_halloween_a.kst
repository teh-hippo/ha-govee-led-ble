# Scene activation immediately following the captured Halloween-A type-1 upload.
id: h6199_scene_halloween_a
data: h6199_scene_halloween_a.bin
imports: [h6199_command_write]
asserts:
  - {actual: opcode, expected: 5}
  - {actual: body.sub_mode, expected: 4}
  - {actual: body.detail.scene_id, expected: 110}
  - {actual: body.detail.scene_class, expected: 1}
