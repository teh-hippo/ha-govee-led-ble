# H6199 static-colour write addressing one segment, captured 2026-08-03 from the Govee Home iOS
# app driving the DreamView T1 over BLE with the phone in Airplane Mode. Taken in one
# session from the Color tab's Subsection view by holding the colour at red and changing
# only which segments were ticked, so the mask is the sole variable across the three.
id: h6199_command_colour_segment_1
data: h6199_command_colour_segment_1.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 21
  - actual: body.detail.operation
    expected: 1
  - actual: body.detail.red
    expected: 255
  - actual: body.detail.green
    expected: 0
  - actual: body.detail.blue
    expected: 0
  - actual: body.detail.kelvin
    expected: 0
  - actual: body.detail.preview.red
    expected: 0
  - actual: body.detail.preview.green
    expected: 0
  - actual: body.detail.preview.blue
    expected: 0
  - actual: body.detail.segment_mask
    expected: 1
