# H6199 colour-mode status reply, captured from the Govee Home iOS app driving the
# DreamView T1 over BLE. Taken with the light in music mode. The same session's write carried the same mode and sensitivity bytes, which is what lets the reply's payload be read rather than guessed.
id: h6199_status_colour_mode_music
data: h6199_status_colour_mode_music.bin
imports:
  - h6199_status_reply
asserts:
  - actual: domain
    expected: 5
  - actual: body.mode
    expected: 19
  - actual: body.detail.mode
    expected: 5
  - actual: body.detail.sensitivity
    expected: 99
  - actual: body.detail.is_calm
    expected: 0
  - actual: body.detail.has_fixed_colour
    expected: 0
  - actual: body.detail.fixed_colour.red
    expected: 0
  - actual: body.detail.fixed_colour.green
    expected: 255
  - actual: body.detail.fixed_colour.blue
    expected: 0
