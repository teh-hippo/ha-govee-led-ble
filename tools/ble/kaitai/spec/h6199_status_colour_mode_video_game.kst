# H6199 fresh-connection colour-mode reply with the retained video profile on Game.
# Against h6199_status_colour_mode_video, only the profile byte and checksum move.
id: h6199_status_colour_mode_video_game
data: h6199_status_colour_mode_video_game.bin
imports:
  - h6199_status_reply
asserts:
  - actual: body.mode
    expected: 0
  - actual: body.detail.region
    expected: 1
  - actual: body.detail.source
    expected: 1
  - actual: body.detail.saturation
    expected: 100
  - actual: body.detail.sound_effects
    expected: 0
  - actual: body.detail.softness
    expected: 100
  - actual: body.detail.opaque_tail
    expected: "0000000000000000000000"
