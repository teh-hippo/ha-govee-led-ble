# H6199 brightness write, captured 2026-08-03 from the Govee Home iOS app driving the
# DreamView T1 over BLE with the phone in Airplane Mode. One of three levels taken in a
# single session by dragging the device page's brightness slider and reading back the
# percentage the app rendered, so the three differ only in the byte under test.
id: h6199_command_brightness_100
data: h6199_command_brightness_100.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 4
  - actual: body.percent
    expected: 100
