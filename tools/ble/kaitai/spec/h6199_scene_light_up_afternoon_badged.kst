# H6199 scene-apply write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE. Applied from More > Light Up Your Life, the Daily tab, using the
# first tile in the Afternoon row. The app displayed "Afternoon"; the tile carried a
# music-note badge, but this case assigns no protocol meaning to that decoration. A
# 119-byte 0xA3 upload immediately preceded the write.
id: h6199_scene_light_up_afternoon_badged
data: h6199_scene_light_up_afternoon_badged.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 10006
  - actual: body.detail.scene_class
    expected: 2
