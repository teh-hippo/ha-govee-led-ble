# H6199 schedule write captured 2026-08-04 from the Govee Home iOS app driving the
# DreamView T1 over BLE with the phone in Airplane Mode, by setting the first row to switch ON at 7:30 repeating Monday, Wednesday and Friday.
# All three writes come from one uninterrupted session on the Timer page.
id: h6199_command_schedule_slot0_0730_mwf
data: h6199_command_schedule_slot0_0730_mwf.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 35
  - actual: body.slot
    expected: 0
  - actual: body.flags
    expected: 129
  - actual: body.hour
    expected: 7
  - actual: body.minute
    expected: 30
  - actual: body.repeat_mask
    expected: 149
