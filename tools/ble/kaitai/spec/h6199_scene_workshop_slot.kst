# H6199 scene-apply write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE, by applying a user effect from More then Workshop. FOUR different
# Workshop effects produced this frame BYTE FOR BYTE while uploading four different bodies of
# 153, 187, 34 and 153 bytes, so id 401 does not identify the effect: it selects the slot the
# upload just filled. That is why there is one fixture here rather than four.
id: h6199_scene_workshop_slot
data: h6199_scene_workshop_slot.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 401
  - actual: body.detail.scene_class
    expected: 2
