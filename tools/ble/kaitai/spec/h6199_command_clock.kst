# First attributable H6199 connect-time clock write.
id: h6199_command_clock
data: h6199_command_clock.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 9
  - actual: body.hour
    expected: 13
  - actual: body.minute
    expected: 35
  - actual: body.second
    expected: 21
  - actual: body.weekday
    expected: 1
  - actual: body.flag1
    expected: 1
  - actual: body.utc_offset_hours
    expected: 10
  - actual: body.utc_offset_minutes
    expected: 0
