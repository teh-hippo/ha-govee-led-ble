# H6199 schedule write captured 2026-08-04 from the Govee Home iOS app driving the
# DreamView T1 over BLE with the phone in Airplane Mode, by enabling the second timer row, the only change from the first.
# All three writes come from one uninterrupted session on the Timer page.
id: h6199_command_schedule_slot1_enabled
data: h6199_command_schedule_slot1_enabled.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 35
  - actual: body.slot
    expected: 1
  - actual: body.flags
    expected: 128
  - actual: body.hour
    expected: 0
  - actual: body.minute
    expected: 0
  - actual: body.repeat_mask
    expected: 128
