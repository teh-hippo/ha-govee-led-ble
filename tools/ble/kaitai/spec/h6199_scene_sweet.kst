# H6199 scene-apply write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE. "Sweet" from the Scene gallery's Life row. Its id sits BETWEEN the two AI effects at 70 and 140, which carry class 0, so no partition of the id range predicts the class byte.
id: h6199_scene_sweet
data: h6199_scene_sweet.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 107
  - actual: body.detail.scene_class
    expected: 1
