# H6199 white-balance write, captured 2026-08-04 from the Govee Home iOS app driving the DreamView T1
# over BLE. The light was off Govee's cloud entirely, so the app could reach it by no path
# but this one. Taken by dragging the white-balance marker along its strip inside Color Calibration. This position was reached once from the left and once from the right and gave the same value both times.
id: h6199_white_balance_mid
data: h6199_white_balance_mid.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 169
  - actual: body.setting
    expected: 0
  - actual: body.len
    expected: 3
  - actual: body.payload.manual
    expected: 1
  - actual: body.payload.red
    expected: 13
  - actual: body.payload.blue
    expected: 3
# This pair is entry 9 of the twenty in the app's bundled whiteBalance.json,
# which is what shows the strip picks an index and the frame carries the gains.
