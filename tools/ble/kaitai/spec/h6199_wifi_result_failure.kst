# The H6199's own report of how a provisioning attempt ended, produced deliberately on our
# own radio 2026-08-04. This one followed a network invented to be impossible; the light tried
# for about eleven seconds, reported this, and returned to its stored network.
id: h6199_wifi_result_failure
data: h6199_wifi_result_failure.bin
imports:
  - h6199_wifi_result
asserts:
  - actual: sub_opcode
    expected: 17
  - actual: status
    expected: 1
