# H6199 scene-apply write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE. "Dating" from the Scene gallery's Life row, applied with NO
# 0xA3 upload before it. Its id appears in the twelve-entry built-in scene list the
# vendor Android app holds for this model, which is why this capture was taken.
id: h6199_scene_dating
data: h6199_scene_dating.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 5
  - actual: body.detail.scene_class
    expected: 1
