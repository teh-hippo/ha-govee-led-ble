# Second attributable H6199 connect-time clock write, taken 2026-08-04 at 09:54:44 on a
# Tuesday. Its whole purpose is to differ from h6199_command_clock, which was recorded on a
# Monday afternoon: a single clock frame cannot tell a weekday byte from a constant, and a
# second one on a known different day and time can.
id: h6199_command_clock_tuesday
data: h6199_command_clock_tuesday.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 9
  - actual: body.hour
    expected: 9
  - actual: body.minute
    expected: 54
  - actual: body.second
    expected: 44
  - actual: body.weekday
    expected: 2
  - actual: body.flag1
    expected: 1
  - actual: body.utc_offset_hours
    expected: 10
  - actual: body.utc_offset_minutes
    expected: 0
