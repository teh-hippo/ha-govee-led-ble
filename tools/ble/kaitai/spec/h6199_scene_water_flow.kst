# H6199 scene-apply write, captured 2026-08-04 from the Govee Home iOS app driving the
# DreamView T1 over BLE. The light was off Govee's cloud, so the app reached it by no path
# but this one; the PHONE was online, which is what made the cloud-backed Effects Lab
# galleries usable at all. Applied from More > Effects Lab, the Harmony Lab tab, "Rain"
# category, preceded by a 136-byte 0xA3 upload. A different tab and a different category
# from Tundra, and it carries the same 0x08 high byte.
id: h6199_scene_water_flow
data: h6199_scene_water_flow.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 2237
  - actual: body.detail.scene_class
    expected: 2
