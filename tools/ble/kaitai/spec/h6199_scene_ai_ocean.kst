# H6199 scene-apply write, captured 2026-08-05 from the Govee Home iOS app driving the
# DreamView T1 over BLE. The effect was generated by the app's AI Lighting Bot from the prompt about ocean ripples, and applied by the app the moment it was generated. Preceded by a seven-frame 0xA3 upload of its definition.
# It carries scene_class 0, which is what falsified reading that byte as whether the light
# already held the scene: it was uploaded exactly like a catalogue one and does not
# carry the catalogue's value.
id: h6199_scene_ai_ocean
data: h6199_scene_ai_ocean.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 140
  - actual: body.detail.scene_class
    expected: 0
