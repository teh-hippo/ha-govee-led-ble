# H6199 white-balance write, captured 2026-08-04 from the Govee Home iOS app driving the DreamView T1
# over BLE. The light was off Govee's cloud entirely, so the app could reach it by no path
# but this one. Taken by pressing the panel's own Reset button, so this is the neutral the app restores.
id: h6199_white_balance_reset
data: h6199_white_balance_reset.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 169
  - actual: body.setting
    expected: 0
  - actual: body.len
    expected: 3
  - actual: body.payload.manual
    expected: 1
  - actual: body.payload.red
    expected: 16
  - actual: body.payload.blue
    expected: 3
# This pair is entry 16 of the twenty in the app's bundled whiteBalance.json,
# which is what shows the strip picks an index and the frame carries the gains.
