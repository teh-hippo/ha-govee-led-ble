# H6199 video read-back captured after a same-session write of Part, Game,
# saturation 20, sound on and softness 12. All five values match the write.
id: h6199_status_colour_mode_video_custom
data: h6199_status_colour_mode_video_custom.bin
imports:
  - h6199_status_reply
asserts:
  - actual: body.mode
    expected: 0
  - actual: body.detail.region
    expected: 0
  - actual: body.detail.source
    expected: 1
  - actual: body.detail.saturation
    expected: 20
  - actual: body.detail.sound_effects
    expected: 1
  - actual: body.detail.softness
    expected: 12
