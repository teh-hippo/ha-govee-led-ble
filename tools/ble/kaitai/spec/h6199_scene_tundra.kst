# H6199 scene-apply write, captured 2026-08-04 from the Govee Home iOS app driving the
# DreamView T1 over BLE. The light was off Govee's cloud, so the app reached it by no path
# but this one; the PHONE was online, which is what made the cloud-backed Effects Lab
# galleries usable at all. Applied from More > Effects Lab, the Gaming Lab tab, "Sandbox 3D"
# category, preceded by a 136-byte 0xA3 upload. Its number carries a 0x08 high byte, a third
# value beyond the 0x00 and 0x3f the scene gallery gave.
id: h6199_scene_tundra
data: h6199_scene_tundra.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 2200
  - actual: body.detail.scene_class
    expected: 2
