# H6199 power-off write, captured 2026-08-03 in the same session as
# h6199_command_power_on and against the same device page, which is what makes the pair a
# controlled comparison rather than two unrelated observations.
id: h6199_command_power_off
data: h6199_command_power_off.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 1
  - actual: body.is_on
    expected: 0
