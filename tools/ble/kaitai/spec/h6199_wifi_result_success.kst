# The H6199's own report of how a provisioning attempt ended, produced deliberately on our
# own radio 2026-08-04. This one followed credentials for a network that existed; an
# independent observer confirmed the light had joined that SSID moments later.
id: h6199_wifi_result_success
data: h6199_wifi_result_success.bin
imports:
  - h6199_wifi_result
asserts:
  - actual: sub_opcode
    expected: 17
  - actual: status
    expected: 0
