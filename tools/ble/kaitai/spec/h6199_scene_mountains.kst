# H6199 scene-apply write, captured 2026-08-04 from the Govee Home iOS app driving the
# DreamView T1 over BLE. The light was off Govee's cloud, so the app reached it by no path
# but this one; the PHONE was online, which is what made the cloud-backed Effects Lab
# galleries usable at all. The other "Sandbox 3D" scene applied from the Gaming Lab tab,
# preceded by a 119-byte 0xA3 upload. It shares Tundra's high byte but sits 22 below it, so
# numbering is not dense inside a category.
id: h6199_scene_mountains
data: h6199_scene_mountains.bin
imports:
  - h6199_command_write
asserts:
  - actual: opcode
    expected: 5
  - actual: body.sub_mode
    expected: 4
  - actual: body.detail.scene_id
    expected: 2178
  - actual: body.detail.scene_class
    expected: 2
