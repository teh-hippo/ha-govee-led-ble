__pycache__/
# No trailing slash. `.venv/` matches a DIRECTORY only, and on a machine where the
# environment is shared between worktrees `.venv` is a symlink, which that rule does not
# match at all: one `git add -A` committed a symlink pointing at another worktree's
# environment, which on merge would have made that worktree's .venv point at itself.
.venv
.*_cache/
.coverage
.build/
dist/
frontend/node_modules/
/custom_components/ha_govee_led_ble/generated_protocol/
/custom_components/ha_govee_led_ble/frontend/effect-studio-bootstrap.js
/custom_components/ha_govee_led_ble/frontend/effect-studio-*-*.js
/custom_components/ha_govee_led_ble/frontend/manifest.json
.playwright-cli/

# Working breadcrumb for the in-flight protocol phase. Never source of truth:
# the worklist lives in the session todo store and the verified structure lives
# in tools/ble/kaitai/*.ksy. Archived to the session workspace when a phase ends.
plan.md
